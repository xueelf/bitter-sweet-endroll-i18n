<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BitterSweetEndroll-i18n</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>BseSetup</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="locales\*.json" />
    <EmbeddedResource Include="payload\app.asar.br" Link="payload/app.asar.br" />
    <EmbeddedResource Include="payload\app.asar.sha256" Link="payload/app.asar.sha256" />
  </ItemGroup>
</Project>
