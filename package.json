{
  "name": "bitter-sweet-endroll-i18n",
  "version": "1.1.1",
  "private": true,
  "description": "游戏《ビタースイートエンドロール ～Bitter Sweets／The End～》的非官方多语言补丁，在程序「设置」界面内添加多语言菜单。",
  "license": "MIT",
  "author": "Yuki <admin@yuki.sh>",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "extract": "bun run scripts/extract.ts",
    "format": "prettier \"**/*.{json,md,ts,yaml,yml}\" --write --experimental-cli",
    "format:check": "prettier \"**/*.{json,md,ts,yaml,yml}\" --check --experimental-cli",
    "installer": "bun run scripts/installer.ts",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "prepare": "husky",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.0",
    "@electron/asar": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-sort": "^1.1.1",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "warn"
    }
  }
}
